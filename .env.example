# Pika API key (dev.pika.art)
PIKA_API_KEY=

# Higgsfield credential (console.higgsfield.ai), written as key-id:secret
HIGGSFIELD_API_KEY=

# Anthropic API key, used only for the optional "Draft with Claude" button
ANTHROPIC_API_KEY=

# Supabase (Project Settings -> API Keys). All three are server-only: never
# rename them with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy anon key also works.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Bypasses RLS: keep it on the server only. The legacy service_role key also works.
SUPABASE_SECRET_KEY=

# Optional. Largest video copied into Storage, in MB. Free plan max is 50.
# VIDEO_MAX_MB=50

# Used once by `npm run create-user` to create the team login. Not read by the app.
# RAMPLE_USER_EMAIL=
# RAMPLE_USER_PASSWORD=
